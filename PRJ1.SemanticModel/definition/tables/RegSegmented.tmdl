table RegSegmented
	lineageTag: 81b0d386-daa6-4052-bdf7-0afbf90143bf

	measure 'Total Revenue' = SUM(RegSegmented[Revenue])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 2b481da9-5a8d-43c4-9bf3-68a28369df55

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Customer' = DISTINCTCOUNT(RegSegmented[Customer_ID])
		formatString: 0
		lineageTag: 726d8b93-1e44-4b46-a25d-d534e9286c63

	measure 'Churned %' =
			
			DIVIDE(
			    CALCULATE(DISTINCTCOUNT(RegSegmented[Customer_ID]), RegSegmented[IsChurned] = TRUE()),
			    DISTINCTCOUNT(RegSegmented[Customer_ID])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 85e56784-418d-45e8-975e-848c52d3bdd1

	measure 'Avg Customer Value' = Divide([Total Revenue] , [Total Customer])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 34a46759-acf2-4d58-9e57-d197907b5624

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Customer Retention %' =
			
			DIVIDE(
			    CALCULATE(DISTINCTCOUNT(RegSegmented[Customer_ID]), RegSegmented[IsChurned] = FALSE()),
			    DISTINCTCOUNT(RegSegmented[Customer_ID])
			)
		lineageTag: 5494cf82-bbb5-4c4c-b766-67818456d4be

		annotation PBI_FormatHint = {"isGeneralNumber":true}

